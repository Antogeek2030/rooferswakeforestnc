---
import Layout from '../../layouts/Layout.astro';
const phone = '+19195550199';
const phoneDisplay = '(919) 555-0199';
---
<Layout title="Storm & Hail Damage Roof Wake Forest NC" description="Storm or hail damage on your Wake Forest roof? Free inspections, insurance documentation, and full repair or replacement.">
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href="/">Home</a> → Problems → Storm Damage</div>
      <h1>Storm &amp; Hail Damage</h1>
      <p>Hail bruises and wind lifts can shorten roof life dramatically if left unaddressed.</p>
    </div>
  </section>
  <section class="section">
    <div class="container content-block">
      <p>We provide free post-storm inspections, photo documentation for insurance, emergency protection, and complete restoration. Working with adjusters is part of our standard process.</p>
      <div style="margin-top:2rem;text-align:center"><a href={`tel:${phone}`} class="btn btn-primary">Call {phoneDisplay}</a></div>
    </div>
  </section>
</Layout>
