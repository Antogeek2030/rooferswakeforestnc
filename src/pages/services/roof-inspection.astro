---
import Layout from '../../layouts/Layout.astro';
const phone = '+19195550199';
const phoneDisplay = '(919) 555-0199';
---
<Layout title="Roof Inspection Wake Forest NC | Free Storm Inspections" description="Professional roof inspections in Wake Forest, NC. Free post-storm inspections, photo reports, and clear repair recommendations. Licensed roofers.">
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href="/">Home</a> → <a href="/#services">Services</a> → Roof Inspection</div>
      <h1>Roof Inspection</h1>
      <p>Detailed inspections after storms, before buying or selling, or when you simply want peace of mind.</p>
    </div>
  </section>
  <section class="section">
    <div class="container content-block">
      <h2>What We Check</h2>
      <p>Shingles, flashing, valleys, penetrations, ridge and soffit vents, gutters, and visible decking or attic conditions. You receive photos and a clear written summary of findings and recommended actions.</p>
      <ul>
        <li>Free post-storm and hail inspections for many homeowners</li>
        <li>Insurance documentation ready</li>
        <li>Honest repair vs. replace guidance</li>
        <li>No high-pressure sales</li>
      </ul>
      <h2>Ideal Times to Inspect</h2>
      <p>After severe weather, before listing your home, when buying a property, or if you notice missing shingles, stains, or granules in the gutters.</p>
      <div style="margin-top:2rem;text-align:center"><a href={`tel:${phone}`} class="btn btn-primary">Schedule Inspection — {phoneDisplay}</a></div>
    </div>
  </section>
</Layout>
