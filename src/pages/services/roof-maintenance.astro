---
import Layout from '../../layouts/Layout.astro';
const phone = '+19195550199';
const phoneDisplay = '(919) 555-0199';
---
<Layout title="Roof Maintenance Wake Forest NC | Preventative Care" description="Roof maintenance in Wake Forest, NC. Debris removal, minor repairs, ventilation checks, and gutter cleaning to extend roof life.">
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href="/">Home</a> → <a href="/#services">Services</a> → Roof Maintenance</div>
      <h1>Roof Maintenance</h1>
      <p>Preventive care that extends the life of your roof and prevents small issues from becoming expensive ones.</p>
    </div>
  </section>
  <section class="section">
    <div class="container content-block">
      <h2>Keep Your Roof Healthy</h2>
      <p>Regular maintenance catches loose shingles, clogged valleys, and ventilation problems before they cause leaks. We offer debris and moss removal, flashing touch-ups, minor shingle replacement, and optional gutter cleaning.</p>
      <ul>
        <li>Debris, leaf, and moss removal</li>
        <li>Flashing and sealant touch-ups</li>
        <li>Ventilation and ridge inspection</li>
        <li>Gutter cleaning options</li>
      </ul>
      <div style="margin-top:2rem;text-align:center"><a href={`tel:${phone}`} class="btn btn-primary">Schedule Maintenance — {phoneDisplay}</a></div>
    </div>
  </section>
</Layout>
