---
import Layout from '../../layouts/Layout.astro';
const phone = '+19195550199';
const phoneDisplay = '(919) 555-0199';
---
<Layout title="Storm Damage Roof Repair Wake Forest NC | Hail & Wind" description="Storm and hail damage roof repair in Wake Forest, NC. Free inspections, insurance claim support, emergency tarping, and full restoration.">
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href="/">Home</a> → <a href="/#services">Services</a> → Storm Damage Repair</div>
      <h1>Storm Damage Repair</h1>
      <p>Hail, high winds, and fallen limbs — we document, protect, and restore your roof.</p>
    </div>
  </section>
  <section class="section">
    <div class="container content-block">
      <h2>From Emergency to Restoration</h2>
      <p>North Carolina storms frequently produce hail and straight-line winds that bruise or lift shingles. We offer free post-storm inspections, thorough documentation for your insurance claim, emergency board-up or tarping when needed, and complete repair or replacement.</p>
      <ul>
        <li>Insurance-friendly process and adjuster meetings</li>
        <li>Emergency protection to limit interior damage</li>
        <li>Matching shingles and quality materials</li>
        <li>Full restoration with workmanship guarantee</li>
      </ul>
      <div style="margin-top:2rem;text-align:center"><a href={`tel:${phone}`} class="btn btn-primary">Call {phoneDisplay} After a Storm</a></div>
    </div>
  </section>
</Layout>
